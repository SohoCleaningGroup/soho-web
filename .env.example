# Database (use an isolated Supabase staging project for Preview)
DATABASE_URL=
DIRECT_URL=

# Application URL (the replacement Preview URL in staging)
NEXT_PUBLIC_APP_URL=

# Supabase Storage (server-only service role; never use an anon key for uploads)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Replacement admin credentials and signing secrets
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PHONE_VERIFICATION_SECRET=

# Optional admin notification recipients (comma-separated)
ADMIN_NOTIFICATION_EMAILS=
ADMIN_NOTIFICATION_PHONES=

# Stripe test mode in Preview
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Isolated Twilio staging/test services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

# Restricted SendGrid staging sender
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
