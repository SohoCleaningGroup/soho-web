generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  phone    String
  role     UserRole @default(USER)

  address   String?
  apartment String?
  city      String?
  state     String?
  zipCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  cleaningType CleaningType
  homeSize     String
  bedrooms     Int?
  bathrooms    Int?
  kitchens     Int?
  hasPets      Boolean      @default(false)

  selectedAddOns String[] @default([])
  addOnTotal     Float    @default(0)

  preferredDate             DateTime?
  preferredTime             String?
  totalSqft                 Int?
  estimatedDurationMinutes  Int?
  frequency                 CleaningFrequency
  specialNotes  String?

  status BookingStatus @default(PENDING)

  payments                 Payment[]
  additionalAuthorizations AdditionalAuthorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BookingSlotHold {
  id                String   @id @default(cuid())
  preferredDate            DateTime
  preferredTime            String
  estimatedDurationMinutes Int
  checkoutSessionId        String?  @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([preferredDate, preferredTime])
  @@index([expiresAt])
}

model ProfessionalProfile {
  id              String  @id @default(cuid())
  fullName        String
  email           String  @unique
  phone           String
  profileImageUrl String?

  idDocumentType     ProfessionalIdDocumentType?
  idDocumentFrontUrl String?
  idDocumentBackUrl  String?
  idDocumentStatus   ProfessionalIdDocumentStatus @default(PENDING)

  idDocumentReuploadToken     String?   @unique
  idDocumentReuploadExpiresAt DateTime?

  experienceYears Int?
  servicesOffered String[]
  serviceAreas    String[]
  availability    String[]

  hasOwnSupplies Boolean @default(false)
  hasTransport   Boolean @default(false)

  bio    String?
  status ProfessionalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorizedAmount          Float
  capturedAmount            Float?
  currency                  String        @default("USD")
  status                    PaymentStatus @default(PENDING)
  isAdditionalAuthorization Boolean       @default(false)

  provider          String  @default("STRIPE")
  paymentIntentId   String? @unique
  checkoutSessionId String? @unique
  transactionId     String?

  authorizedAt DateTime?
  paidAt       DateTime?
  cancelledAt  DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  additionalAuthorizations AdditionalAuthorization[]

  @@index([bookingId])
  @@index([status])
  @@index([provider])
}

model AdditionalAuthorization {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  token String @unique

  additionalAmount Float
  reason           String?

  status AdditionalAuthorizationStatus @default(PENDING)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  expiresAt DateTime

  authorizedAt DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum AdditionalAuthorizationStatus {
  PENDING
  AUTHORIZED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum UserRole {
  USER
  PROFESSIONAL
  ADMIN
}

enum CleaningType {
  SOHO_SIGNATURE
  SOHO_SIGNATURE_DEEP
  MOVE_IN_MOVE_OUT
  RECURRING
  AIRBNB_TURNOVER
}

enum CleaningFrequency {
  ONE_TIME
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum ProfessionalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProfessionalIdDocumentType {
  NATIONAL_ID
  PASSPORT
}

enum ProfessionalIdDocumentStatus {
  PENDING
  APPROVED
  REUPLOAD_REQUESTED
}
