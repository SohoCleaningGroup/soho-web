generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserProfile {
  id       String   @id @default(cuid())
  fullName String
  email    String   @unique
  phone    String
  role     UserRole @default(USER)

  address   String?
  apartment String?
  city      String?
  state     String?
  zipCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralAccount ReferralAccount?
  bookings Booking[]
}

model Booking {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  cleaningType CleaningType
  homeSize     String
  bedrooms     Int?
  bathrooms    Int?
  kitchens     Int?
  hasPets      Boolean      @default(false)

  selectedAddOns String[] @default([])
  addOnTotal     Float    @default(0)

  preferredDate             DateTime?
  preferredTime             String?
  totalSqft                 Int?
  estimatedDurationMinutes  Int?
  frequency                 CleaningFrequency
  specialNotes  String?

  acceptedSmsConsent Boolean @default(false)
  smsConsentAt DateTime?
  smsConsentPhone String?
  smsConsentVersion String?

  status BookingStatus @default(PENDING)

  referralUse ReferralUse?
  jobAssignment JobAssignment?

  payments                 Payment[]
  additionalAuthorizations AdditionalAuthorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BookingSlotHold {
  id                String   @id @default(cuid())
  preferredDate            DateTime
  preferredTime            String
  estimatedDurationMinutes Int
  checkoutSessionId        String?  @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([preferredDate, preferredTime])
  @@index([expiresAt])
}

model ProfessionalProfile {
  jobAssignments JobAssignment[]
  payNotices CleanerPayNotice[]
  weeklyAvailability CleanerWeeklyAvailability[]
  id              String  @id @default(cuid())
  fullName        String
  email           String  @unique
  phone           String
  profileImageUrl String?

  idDocumentType     ProfessionalIdDocumentType?
  idDocumentFrontUrl String?
  idDocumentBackUrl  String?
  idDocumentStatus   ProfessionalIdDocumentStatus @default(PENDING)

  idDocumentReuploadToken     String?   @unique
  idDocumentReuploadExpiresAt DateTime?

  experienceYears Int?
  servicesOffered String[]
  serviceAreas    String[]
  availability    String[]

  hasOwnSupplies Boolean @default(false)
  hasTransport   Boolean @default(false)

  screeningResponses Json?

  hiringTermsTokenHash      String?   @unique
  hiringTermsTokenExpiresAt DateTime?
  hiringTermsSignedAt       DateTime?
  hiringTermsSignedName     String?
  hiringTermsVersion        String?
  hiringTermsSnapshot       String?
  hiringTermsHash           String?
  hiringTermsIp             String?
  hiringTermsUserAgent      String?

  bio    String?
  status ProfessionalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  authorizedAmount          Float
  capturedAmount            Float?
  currency                  String        @default("USD")
  status                    PaymentStatus @default(PENDING)
  isAdditionalAuthorization Boolean       @default(false)

  provider          String  @default("STRIPE")
  paymentIntentId   String? @unique
  checkoutSessionId String? @unique
  transactionId     String?

  authorizedAt DateTime?
  paidAt       DateTime?
  cancelledAt  DateTime?
  failedAt     DateTime?
  refundedAt   DateTime?

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  additionalAuthorizations AdditionalAuthorization[]

  @@index([bookingId])
  @@index([status])
  @@index([provider])
}

model AdditionalAuthorization {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  token String @unique

  additionalAmount Float
  reason           String?

  status AdditionalAuthorizationStatus @default(PENDING)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  expiresAt DateTime

  authorizedAt DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

enum AdditionalAuthorizationStatus {
  PENDING
  AUTHORIZED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

enum UserRole {
  USER
  PROFESSIONAL
  ADMIN
}

enum CleaningType {
  SOHO_SIGNATURE
  SOHO_SIGNATURE_DEEP
  MOVE_IN_MOVE_OUT
  RECURRING
  AIRBNB_TURNOVER
}

enum CleaningFrequency {
  ONE_TIME
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum ProfessionalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ProfessionalIdDocumentType {
  NATIONAL_ID
  PASSPORT
}

enum ProfessionalIdDocumentStatus {
  PENDING
  APPROVED
  REUPLOAD_REQUESTED
}

model CleanerWeeklyAvailability {
  id             String              @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekStart      DateTime
  windows        Json
  submittedAt    DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([professionalId, weekStart])
  @@index([weekStart])
}

model JobAssignment {
  id String @id @default(cuid())
  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  professionalId String
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id])
  tokenHash String @unique
  expiresAt DateTime
  status String @default("PENDING")
  respondedAt DateTime?
  reviewTokenHash String? @unique
  reviewExpiresAt DateTime?
  reviewStatus String @default("NONE")
  reviewNote String?
  reviewedAt DateTime?
  reviewSentAt DateTime?
  photos JobPhoto[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([professionalId])
}
model JobPhoto {
  id String @id @default(cuid())
  assignmentId String
  assignment JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  path String @unique
  createdAt DateTime @default(now())
  @@index([assignmentId])
}

model ReferralAccount {
  id String @id @default(cuid())
  userProfileId String @unique
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  code String @unique
  rewardCode String @unique
  uses ReferralUse[]
  createdAt DateTime @default(now())
}

model ReferralUse {
  id String @id @default(cuid())
  accountId String
  account ReferralAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind String
  status String @default("RESERVED")
  customerKey String? @unique
  rewardSourceId String? @unique
  rewardSource ReferralUse? @relation("RewardSource", fields: [rewardSourceId], references: [id], onDelete: Restrict)
  rewardClaim ReferralUse? @relation("RewardSource")
  bookingId String? @unique
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  checkoutSessionId String? @unique
  discountCents Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([accountId, status])
}

model CleanerPayNotice {
  employeeName String
  id String @id @default(cuid())
  professionalId String
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  primaryLanguage String
  effectiveDate String
  version String
  snapshot String
  snapshotHash String
  tokenHash String @unique
  expiresAt DateTime
  sentAt DateTime?
  signedAt DateTime?
  signedName String?
  signedIp String?
  signedUserAgent String?
  receiptSentAt DateTime?
  createdAt DateTime @default(now())

  @@index([professionalId, createdAt])
}

// Public consent intake. Only the server may read or write this audit record.
model SmsConsentRecord {
  id String @id @default(cuid())
  fullName String
  email String
  phone String
  accepted Boolean
  version String
  disclosure String
  source String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}
